{
  "name": "thermo-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "export": "node --import tsx server/export.ts",
    "build": "npm run typecheck && npm run export && vite build",
    "preview": "vite preview",
    "test:browser": "playwright test -c tests/playwright.config.ts"
  },
  "dependencies": {
    "lossless-json": "4.3.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "prettier": "3.9.8",
    "tsx": "4.23.14",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
