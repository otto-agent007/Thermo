{
  "$defs": {
    "BackendId": {
      "description": "Backends that are genuinely implemented in this repository.",
      "enum": [
        "exact_ising",
        "numpy_exact_categorical",
        "torx_statevector",
        "thrml_local",
        "z1_cost_model"
      ],
      "title": "BackendId",
      "type": "string"
    },
    "ComparisonProtocol": {
      "additionalProperties": false,
      "properties": {
        "identity_version": {
          "const": "matched_training_budget.v1",
          "default": "matched_training_budget.v1",
          "title": "Identity Version",
          "type": "string"
        },
        "step_count": {
          "default": 5,
          "maximum": 5,
          "minimum": 5,
          "title": "Step Count",
          "type": "integer"
        },
        "batch_size": {
          "default": 32768,
          "maximum": 32768,
          "minimum": 32768,
          "title": "Batch Size",
          "type": "integer"
        },
        "evaluation_horizon": {
          "default": 4,
          "maximum": 4,
          "minimum": 4,
          "title": "Evaluation Horizon",
          "type": "integer"
        },
        "learning_rate": {
          "default": 0.01,
          "maximum": 0.01,
          "minimum": 0.01,
          "title": "Learning Rate",
          "type": "number"
        },
        "parameter_cap": {
          "default": 2.0,
          "maximum": 2.0,
          "minimum": 2.0,
          "title": "Parameter Cap",
          "type": "number"
        },
        "beta": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 1.0,
          "title": "Beta",
          "type": "number"
        },
        "dtype": {
          "const": "float64",
          "default": "float64",
          "title": "Dtype",
          "type": "string"
        },
        "role_policy": {
          "const": "SeedSequence([0x4D3442, seed]).spawn(21); finite roles 0:10; equilibrium roles 10:20; evaluation role 20",
          "default": "SeedSequence([0x4D3442, seed]).spawn(21); finite roles 0:10; equilibrium roles 10:20; evaluation role 20",
          "title": "Role Policy",
          "type": "string"
        },
        "training_policy": {
          "const": "arm-specific occupancy and gradient laws; independent occupancy/gradient roles; same-parent independent non-propagated references; sum shared occurrences first",
          "default": "arm-specific occupancy and gradient laws; independent occupancy/gradient roles; same-parent independent non-propagated references; sum shared occurrences first",
          "title": "Training Policy",
          "type": "string"
        },
        "checkpoint_policy": {
          "const": "always_fifth_update",
          "default": "always_fifth_update",
          "title": "Checkpoint Policy",
          "type": "string"
        },
        "evaluation_policy": {
          "const": "fresh K4 paired initial/finite, initial/equilibrium, equilibrium/finite; shared stream",
          "default": "fresh K4 paired initial/finite, initial/equilibrium, equilibrium/finite; shared stream",
          "title": "Evaluation Policy",
          "type": "string"
        },
        "primary_contrast": {
          "const": "finite_minus_equilibrium",
          "default": "finite_minus_equilibrium",
          "title": "Primary Contrast",
          "type": "string"
        },
        "cost_policy": {
          "const": "matched_draws_and_updates_not_hardware_cost",
          "default": "matched_draws_and_updates_not_hardware_cost",
          "title": "Cost Policy",
          "type": "string"
        },
        "objective_policy": {
          "const": "unbiased_order_two_u_statistic",
          "default": "unbiased_order_two_u_statistic",
          "title": "Objective Policy",
          "type": "string"
        },
        "uncertainty_policy": {
          "const": "paired_delete_one_jackknife_normal_95_approximate",
          "default": "paired_delete_one_jackknife_normal_95_approximate",
          "title": "Uncertainty Policy",
          "type": "string"
        },
        "scientific_status": {
          "const": "descriptive_non_gating",
          "default": "descriptive_non_gating",
          "title": "Scientific Status",
          "type": "string"
        },
        "replay_relative_tolerance": {
          "default": 1e-12,
          "maximum": 1e-12,
          "minimum": 1e-12,
          "title": "Replay Relative Tolerance",
          "type": "number"
        },
        "replay_absolute_tolerance": {
          "default": 1e-10,
          "maximum": 1e-10,
          "minimum": 1e-10,
          "title": "Replay Absolute Tolerance",
          "type": "number"
        }
      },
      "title": "ComparisonProtocol",
      "type": "object"
    },
    "ComparisonRequest": {
      "additionalProperties": false,
      "properties": {
        "identity_version": {
          "const": "matched_training_request.v1",
          "default": "matched_training_request.v1",
          "title": "Identity Version",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/ComparisonProtocol"
        },
        "seed": {
          "maximum": 2,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "source_archive_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Archive Digest",
          "type": "string"
        },
        "source_summary_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Summary Digest",
          "type": "string"
        },
        "source_request_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Request Hash",
          "type": "string"
        },
        "initial_parameter_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Initial Parameter Digest",
          "type": "string"
        },
        "exact_target_reference": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Exact Target Reference",
          "type": "string"
        },
        "schedule_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schedule Digest",
          "type": "string"
        },
        "source_policy": {
          "const": "original_M1_sources_embedded_in_M4_at_e6ce897",
          "default": "original_M1_sources_embedded_in_M4_at_e6ce897",
          "title": "Source Policy",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "seed",
        "source_archive_digest",
        "source_summary_digest",
        "source_request_hash",
        "initial_parameter_digest",
        "exact_target_reference",
        "schedule_digest"
      ],
      "title": "ComparisonRequest",
      "type": "object"
    },
    "EvidenceClass": {
      "description": "Mandatory claim-level evidence categories.",
      "enum": [
        "exact_reference",
        "software_simulation",
        "calibrated_projection",
        "physical_hardware"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "ExperimentSpec": {
      "additionalProperties": false,
      "description": "Requested experiment inputs; no observations or runtime metadata.",
      "properties": {
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "model_config": {
          "additionalProperties": true,
          "title": "Model Config",
          "type": "object"
        },
        "run_config": {
          "additionalProperties": true,
          "title": "Run Config",
          "type": "object"
        },
        "sample_definition": {
          "minLength": 1,
          "title": "Sample Definition",
          "type": "string"
        }
      },
      "required": [
        "experiment_id",
        "seed",
        "model_config",
        "run_config",
        "sample_definition"
      ],
      "title": "ExperimentSpec",
      "type": "object"
    },
    "FiniteRefinementStep": {
      "additionalProperties": false,
      "properties": {
        "iteration": {
          "maximum": 5,
          "minimum": 1,
          "title": "Iteration",
          "type": "integer"
        },
        "parameter_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parameter Digest",
          "type": "string"
        },
        "exact_tables_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Exact Tables Digest",
          "type": "string"
        },
        "occupancy_seed": {
          "minimum": 0,
          "title": "Occupancy Seed",
          "type": "integer"
        },
        "gradient_seed": {
          "minimum": 0,
          "title": "Gradient Seed",
          "type": "integer"
        },
        "occupancy": {
          "$ref": "#/$defs/TerminalOccupancyResult"
        },
        "reward_coefficient": {
          "items": {
            "type": "number"
          },
          "title": "Reward Coefficient",
          "type": "array"
        },
        "gradient": {
          "$ref": "#/$defs/GroupedGradientResult"
        },
        "update": {
          "$ref": "#/$defs/GroupedParameterUpdateResult"
        }
      },
      "required": [
        "iteration",
        "parameter_digest",
        "exact_tables_digest",
        "occupancy_seed",
        "gradient_seed",
        "occupancy",
        "reward_coefficient",
        "gradient",
        "update"
      ],
      "title": "FiniteRefinementStep",
      "type": "object"
    },
    "GroupedGradientResult": {
      "additionalProperties": false,
      "properties": {
        "sample_count": {
          "exclusiveMinimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "component_sum": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Component Sum",
          "type": "array"
        },
        "component_sum_squares": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Component Sum Squares",
          "type": "array"
        },
        "source_digest": {
          "title": "Source Digest",
          "type": "string"
        }
      },
      "required": [
        "sample_count",
        "component_sum",
        "component_sum_squares",
        "source_digest"
      ],
      "title": "GroupedGradientResult",
      "type": "object"
    },
    "GroupedParameterUpdateResult": {
      "additionalProperties": false,
      "properties": {
        "raw_parameters": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Raw Parameters",
          "type": "array"
        },
        "updated_parameters": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Updated Parameters",
          "type": "array"
        },
        "cap_active_mask": {
          "items": {
            "items": {
              "type": "boolean"
            },
            "type": "array"
          },
          "title": "Cap Active Mask",
          "type": "array"
        },
        "cap_active_parameter_count": {
          "minimum": 0,
          "title": "Cap Active Parameter Count",
          "type": "integer"
        },
        "bounds_satisfied": {
          "title": "Bounds Satisfied",
          "type": "boolean"
        },
        "update_digest": {
          "title": "Update Digest",
          "type": "string"
        }
      },
      "required": [
        "raw_parameters",
        "updated_parameters",
        "cap_active_mask",
        "cap_active_parameter_count",
        "bounds_satisfied",
        "update_digest"
      ],
      "title": "GroupedParameterUpdateResult",
      "type": "object"
    },
    "HorizonTerminalEvidence": {
      "additionalProperties": false,
      "description": "Only bounded integer summaries; scientific scalars are reconstructed on demand.",
      "properties": {
        "horizon": {
          "enum": [
            "equilibrium",
            "k1",
            "k2",
            "k4",
            "k8",
            "k16",
            "k30"
          ],
          "title": "Horizon",
          "type": "string"
        },
        "table_evidence_class": {
          "const": "exact_reference",
          "default": "exact_reference",
          "title": "Table Evidence Class",
          "type": "string"
        },
        "exact_tables_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Exact Tables Digest",
          "type": "string"
        },
        "sample_count": {
          "minimum": 3,
          "title": "Sample Count",
          "type": "integer"
        },
        "before_counts": {
          "items": {
            "type": "integer"
          },
          "title": "Before Counts",
          "type": "array"
        },
        "after_counts": {
          "items": {
            "type": "integer"
          },
          "title": "After Counts",
          "type": "array"
        },
        "joined_moment_counts": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Joined Moment Counts",
          "type": "array"
        },
        "before_particle_histogram": {
          "items": {
            "type": "integer"
          },
          "title": "Before Particle Histogram",
          "type": "array"
        },
        "after_particle_histogram": {
          "items": {
            "type": "integer"
          },
          "title": "After Particle Histogram",
          "type": "array"
        },
        "paired_leakage_counts": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Paired Leakage Counts",
          "type": "array"
        }
      },
      "required": [
        "horizon",
        "exact_tables_digest",
        "sample_count",
        "before_counts",
        "after_counts",
        "joined_moment_counts",
        "before_particle_histogram",
        "after_particle_histogram",
        "paired_leakage_counts"
      ],
      "title": "HorizonTerminalEvidence",
      "type": "object"
    },
    "MetricObservation": {
      "additionalProperties": false,
      "description": "One claim and the evidence supporting it.",
      "properties": {
        "value": {
          "title": "Value"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "value",
        "evidence_class",
        "method"
      ],
      "title": "MetricObservation",
      "type": "object"
    },
    "PackageProvenance": {
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "title": "Distribution",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "release_source_repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Source Repository"
        },
        "release_source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Source Commit"
        },
        "expected_wheel_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Wheel Sha256"
        },
        "artifact_verification": {
          "title": "Artifact Verification",
          "type": "string"
        }
      },
      "required": [
        "distribution",
        "version",
        "artifact_verification"
      ],
      "title": "PackageProvenance",
      "type": "object"
    },
    "RunRecord": {
      "additionalProperties": false,
      "description": "Observed output from exactly one backend execution.",
      "properties": {
        "schema_version": {
          "const": "1.1.0",
          "default": "1.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "created_at_utc": {
          "format": "date-time",
          "title": "Created At Utc",
          "type": "string"
        },
        "backend_id": {
          "$ref": "#/$defs/BackendId"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "spec": {
          "$ref": "#/$defs/ExperimentSpec"
        },
        "model_hash": {
          "title": "Model Hash",
          "type": "string"
        },
        "run_config_hash": {
          "title": "Run Config Hash",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/RuntimeProvenance"
        },
        "timing": {
          "$ref": "#/$defs/RunTiming"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricObservation"
          },
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "backend_id",
        "evidence_class",
        "spec",
        "model_hash",
        "run_config_hash",
        "provenance",
        "timing",
        "metrics"
      ],
      "title": "RunRecord",
      "type": "object"
    },
    "RunTiming": {
      "additionalProperties": false,
      "properties": {
        "evidence_class": {
          "const": "software_simulation",
          "title": "Evidence Class",
          "type": "string"
        },
        "unit": {
          "const": "seconds",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "compile_seconds": {
          "minimum": 0,
          "title": "Compile Seconds",
          "type": "number"
        },
        "execution_seconds": {
          "minimum": 0,
          "title": "Execution Seconds",
          "type": "number"
        },
        "synchronized": {
          "title": "Synchronized",
          "type": "boolean"
        },
        "timing_method": {
          "minLength": 1,
          "title": "Timing Method",
          "type": "string"
        }
      },
      "required": [
        "evidence_class",
        "unit",
        "source",
        "compile_seconds",
        "execution_seconds",
        "synchronized",
        "timing_method"
      ],
      "title": "RunTiming",
      "type": "object"
    },
    "RuntimeProvenance": {
      "additionalProperties": false,
      "properties": {
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "jax_version": {
          "title": "Jax Version",
          "type": "string"
        },
        "jaxlib_version": {
          "title": "Jaxlib Version",
          "type": "string"
        },
        "jax_backend": {
          "title": "Jax Backend",
          "type": "string"
        },
        "jax_devices": {
          "items": {
            "type": "string"
          },
          "title": "Jax Devices",
          "type": "array"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Git Commit"
        },
        "git_dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Git Dirty"
        },
        "jax_enable_x64": {
          "title": "Jax Enable X64",
          "type": "boolean"
        },
        "packages": {
          "items": {
            "$ref": "#/$defs/PackageProvenance"
          },
          "title": "Packages",
          "type": "array"
        }
      },
      "required": [
        "python_version",
        "platform",
        "jax_version",
        "jaxlib_version",
        "jax_backend",
        "jax_devices",
        "git_commit",
        "git_dirty",
        "jax_enable_x64",
        "packages"
      ],
      "title": "RuntimeProvenance",
      "type": "object"
    },
    "TerminalOccupancyResult": {
      "additionalProperties": false,
      "properties": {
        "sample_count": {
          "exclusiveMinimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "occupancy_counts": {
          "items": {
            "type": "integer"
          },
          "title": "Occupancy Counts",
          "type": "array"
        },
        "source_digest": {
          "title": "Source Digest",
          "type": "string"
        }
      },
      "required": [
        "sample_count",
        "occupancy_counts",
        "source_digest"
      ],
      "title": "TerminalOccupancyResult",
      "type": "object"
    },
    "TrainingArm": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "finite_k4",
            "equilibrium"
          ],
          "title": "Name",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/FiniteRefinementStep"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "name",
        "steps"
      ],
      "title": "TrainingArm",
      "type": "object"
    },
    "TrainingComparison": {
      "additionalProperties": false,
      "properties": {
        "evidence_class": {
          "const": "software_simulation",
          "default": "software_simulation",
          "title": "Evidence Class",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/ComparisonProtocol"
        },
        "seed": {
          "maximum": 2,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "initial_parameters": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Initial Parameters",
          "type": "array"
        },
        "occurrence_target_indices": {
          "items": {
            "type": "integer"
          },
          "title": "Occurrence Target Indices",
          "type": "array"
        },
        "occurrence_site_indices": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Occurrence Site Indices",
          "type": "array"
        },
        "target_occupancy": {
          "items": {
            "type": "number"
          },
          "title": "Target Occupancy",
          "type": "array"
        },
        "arms": {
          "items": {
            "$ref": "#/$defs/TrainingArm"
          },
          "title": "Arms",
          "type": "array"
        },
        "evaluation_seed": {
          "minimum": 0,
          "title": "Evaluation Seed",
          "type": "integer"
        },
        "initial_finite": {
          "$ref": "#/$defs/HorizonTerminalEvidence"
        },
        "initial_equilibrium": {
          "$ref": "#/$defs/HorizonTerminalEvidence"
        },
        "primary_evaluation": {
