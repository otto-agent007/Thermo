{
  "$defs": {
    "BackendId": {
      "description": "Backends that are genuinely implemented in this repository.",
      "enum": [
        "exact_ising",
        "numpy_exact_categorical",
        "torx_statevector",
        "thrml_local",
        "z1_cost_model"
      ],
      "title": "BackendId",
      "type": "string"
    },
    "EvidenceClass": {
      "description": "Mandatory claim-level evidence categories.",
      "enum": [
        "exact_reference",
        "software_simulation",
        "calibrated_projection",
        "physical_hardware"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "ExperimentSpec": {
      "additionalProperties": false,
      "description": "Requested experiment inputs; no observations or runtime metadata.",
      "properties": {
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "model_config": {
          "additionalProperties": true,
          "title": "Model Config",
          "type": "object"
        },
        "run_config": {
          "additionalProperties": true,
          "title": "Run Config",
          "type": "object"
        },
        "sample_definition": {
          "minLength": 1,
          "title": "Sample Definition",
          "type": "string"
        }
      },
      "required": [
        "experiment_id",
        "seed",
        "model_config",
        "run_config",
        "sample_definition"
      ],
      "title": "ExperimentSpec",
      "type": "object"
    },
    "FiniteRefinementProtocol": {
      "additionalProperties": false,
      "properties": {
        "identity_version": {
          "const": "bounded_finite_refinement_protocol.v1",
          "default": "bounded_finite_refinement_protocol.v1",
          "title": "Identity Version",
          "type": "string"
        },
        "step_count": {
          "default": 5,
          "maximum": 5,
          "minimum": 5,
          "title": "Step Count",
          "type": "integer"
        },
        "horizon": {
          "default": 4,
          "maximum": 4,
          "minimum": 4,
          "title": "Horizon",
          "type": "integer"
        },
        "batch_size": {
          "default": 32768,
          "maximum": 32768,
          "minimum": 32768,
          "title": "Batch Size",
          "type": "integer"
        },
        "learning_rate": {
          "default": 0.01,
          "maximum": 0.01,
          "minimum": 0.01,
          "title": "Learning Rate",
          "type": "number"
        },
        "parameter_cap": {
          "default": 2.0,
          "maximum": 2.0,
          "minimum": 2.0,
          "title": "Parameter Cap",
          "type": "number"
        },
        "beta": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 1.0,
          "title": "Beta",
          "type": "number"
        },
        "dtype": {
          "const": "float64",
          "default": "float64",
          "title": "Dtype",
          "type": "string"
        },
        "checkpoint_policy": {
          "const": "always_fifth_update",
          "default": "always_fifth_update",
          "title": "Checkpoint Policy",
          "type": "string"
        },
        "role_policy": {
          "const": "SeedSequence([0x4D34, seed]).spawn(11); alternating occupancy/gradient; final evaluation last",
          "default": "SeedSequence([0x4D34, seed]).spawn(11); alternating occupancy/gradient; final evaluation last",
          "title": "Role Policy",
          "type": "string"
        },
        "endpoint_policy": {
          "const": "uniform reset; hidden then outputs; hidden-major joint inverse CDF; propagate outputs only",
          "default": "uniform reset; hidden then outputs; hidden-major joint inverse CDF; propagate outputs only",
          "title": "Endpoint Policy",
          "type": "string"
        },
        "gradient_policy": {
          "const": "finite endpoint main-minus-independent-same-parent-reference scores; sum shared occurrences first",
          "default": "finite endpoint main-minus-independent-same-parent-reference scores; sum shared occurrences first",
          "title": "Gradient Policy",
          "type": "string"
        },
        "reward_policy": {
          "const": "two times (independent occupancy estimate minus exact target)",
          "default": "two times (independent occupancy estimate minus exact target)",
          "title": "Reward Policy",
          "type": "string"
        },
        "evaluation_policy": {
          "const": "fresh initial/fifth paired evaluation; common random numbers; no checkpoint selection",
          "default": "fresh initial/fifth paired evaluation; common random numbers; no checkpoint selection",
          "title": "Evaluation Policy",
          "type": "string"
        },
        "objective_policy": {
          "const": "unbiased_order_two_u_statistic",
          "default": "unbiased_order_two_u_statistic",
          "title": "Objective Policy",
          "type": "string"
        },
        "uncertainty_policy": {
          "const": "paired_delete_one_jackknife_normal_95_approximate",
          "default": "paired_delete_one_jackknife_normal_95_approximate",
          "title": "Uncertainty Policy",
          "type": "string"
        },
        "scientific_status": {
          "const": "descriptive_non_gating",
          "default": "descriptive_non_gating",
          "title": "Scientific Status",
          "type": "string"
        },
        "sampler_identity_policy": {
          "const": "normalize signed zero in parameter and reward cache identities",
          "default": "normalize signed zero in parameter and reward cache identities",
          "title": "Sampler Identity Policy",
          "type": "string"
        },
        "replay_relative_tolerance": {
          "default": 1e-12,
          "maximum": 1e-12,
          "minimum": 1e-12,
          "title": "Replay Relative Tolerance",
          "type": "number"
        },
        "replay_absolute_tolerance": {
          "default": 1e-10,
          "maximum": 1e-10,
          "minimum": 1e-10,
          "title": "Replay Absolute Tolerance",
          "type": "number"
        }
      },
      "title": "FiniteRefinementProtocol",
      "type": "object"
    },
    "FiniteRefinementRequest": {
      "additionalProperties": false,
      "properties": {
        "identity_version": {
          "const": "bounded_finite_refinement_request.v1",
          "default": "bounded_finite_refinement_request.v1",
          "title": "Identity Version",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/FiniteRefinementProtocol"
        },
        "source_summary_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Summary Digest",
          "type": "string"
        },
        "source_request_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Request Hash",
          "type": "string"
        },
        "source_bundle_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Bundle Digest",
          "type": "string"
        },
        "initial_parameter_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Initial Parameter Digest",
          "type": "string"
        },
        "exact_target_reference": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Exact Target Reference",
          "type": "string"
        },
        "schedule_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schedule Digest",
          "type": "string"
        },
        "sampler_request_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sampler Request Hash",
          "type": "string"
        },
        "seed": {
          "maximum": 2,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "site_count": {
          "default": 25,
          "maximum": 25,
          "minimum": 25,
          "title": "Site Count",
          "type": "integer"
        },
        "occurrence_count": {
          "default": 500,
          "maximum": 500,
          "minimum": 500,
          "title": "Occurrence Count",
          "type": "integer"
        },
        "parameter_group_count": {
          "default": 37,
          "maximum": 37,
          "minimum": 37,
          "title": "Parameter Group Count",
          "type": "integer"
        },
        "start_policy": {
          "const": "supplied_M1_initial_model_context_parameters",
          "default": "supplied_M1_initial_model_context_parameters",
          "title": "Start Policy",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "source_summary_digest",
        "source_request_hash",
        "source_bundle_digest",
        "initial_parameter_digest",
        "exact_target_reference",
        "schedule_digest",
        "sampler_request_hash",
        "seed"
      ],
      "title": "FiniteRefinementRequest",
      "type": "object"
    },
    "FiniteRefinementStep": {
      "additionalProperties": false,
      "properties": {
        "iteration": {
          "maximum": 5,
          "minimum": 1,
          "title": "Iteration",
          "type": "integer"
        },
        "parameter_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parameter Digest",
          "type": "string"
        },
        "exact_tables_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Exact Tables Digest",
          "type": "string"
        },
        "occupancy_seed": {
          "minimum": 0,
          "title": "Occupancy Seed",
          "type": "integer"
        },
        "gradient_seed": {
          "minimum": 0,
          "title": "Gradient Seed",
          "type": "integer"
        },
        "occupancy": {
          "$ref": "#/$defs/TerminalOccupancyResult"
        },
        "reward_coefficient": {
          "items": {
            "type": "number"
          },
          "title": "Reward Coefficient",
          "type": "array"
        },
        "gradient": {
          "$ref": "#/$defs/GroupedGradientResult"
        },
        "update": {
          "$ref": "#/$defs/GroupedParameterUpdateResult"
        }
      },
      "required": [
        "iteration",
        "parameter_digest",
        "exact_tables_digest",
        "occupancy_seed",
        "gradient_seed",
        "occupancy",
        "reward_coefficient",
        "gradient",
        "update"
      ],
      "title": "FiniteRefinementStep",
      "type": "object"
    },
    "FiniteSamplerAudit": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
