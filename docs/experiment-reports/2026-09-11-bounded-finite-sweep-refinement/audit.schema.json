          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Exact Tables Digest",
          "type": "string"
        },
        "sample_count": {
          "minimum": 3,
          "title": "Sample Count",
          "type": "integer"
        },
        "before_counts": {
          "items": {
            "type": "integer"
